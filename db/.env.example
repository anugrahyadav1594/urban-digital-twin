# ---- Database (same names used by the existing db/db_config.py) ----
POSTGIS_HOST=localhost
POSTGIS_PORT=5432
POSTGIS_DB=nagar_x_db
POSTGIS_USER=postgres
POSTGIS_PASSWORD=2415

# ---- CRS policy (ARCHITECTURE §6.5) ----
# Storage is always 4326. Analysis CRS must be PROJECTED.
# Adivali-devad / NAINA, Navi Mumbai -> UTM 43N.
STORAGE_SRID=4326
ANALYSIS_SRID=32643

# ---- Versioning (§25) ----
ACTIVE_DATASET_VERSION=1

# ---- Pool / safety ----
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false
SQL_STATEMENT_TIMEOUT_MS=30000
