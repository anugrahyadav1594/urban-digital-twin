# Optional. Leave empty to run fully offline-ish with OpenStreetMap imagery.
# With a token you get Cesium World Terrain + Google/Cesium OSM Buildings.
NEXT_PUBLIC_CESIUM_ION_TOKEN=

# Backend base URL. When unreachable the app transparently falls back to
# the deterministic mock engine in lib/mock.ts (demo mode).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Pilot city centre (lon, lat)
NEXT_PUBLIC_CITY_LON=73.7389
NEXT_PUBLIC_CITY_LAT=18.5913
