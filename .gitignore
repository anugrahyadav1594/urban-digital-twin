# ==========================================
# Urban Digital Twin - Root .gitignore
# ==========================================

# ── Node.js & Next.js Frontend ────────────
node_modules/
.next/
out/
build/
dist/
.swc/
.turbo/
coverage/
*.tsbuildinfo
next-env.d.ts

# ── Cesium Libraries & Generated Assets ───
frontend/public/cesium/
public/cesium/

# ── Python, FastAPI & Backend ─────────────
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.tox/
.coverage
htmlcov/

# ── Environment & Secrets ─────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*
!.env.example

# ── Geospatial & Heavy GIS Artifacts ──────
data/raw/
data/processed/
data/tiles/
data/cache/
*.tif
*.tiff
*.pbf
*.laz
*.las
*.gpkg
*.parquet
*.shp
*.dbf
*.shx
*.prj
# Exception for tracked frontend public data files
!frontend/public/data/

# ── Databases & Persistent Volumes ────────
db/data/
postgres_data/
redis_data/
*.sqlite
*.db

# ── Logs & Debugging ──────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.temp

# ── OS & IDE Settings ─────────────────────
.DS_Store
Thumbs.db
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
